{
  "manifest_version": 3,
  "name": "Local Privacy Auditor",
  "version": "1.0",
  "description": "Scans privacy policies locally using Chrome's built-in AI or Regex fallback.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

